<?xml version="1.0"?>
<!-- ########################################### -->
<!-- Gazebo Additional Description of robot -->
<!-- Chetan VJ© -->
<!-- ########################################### -->

<robot>
<!-- Physical Properties -->
<gazebo reference="body_link">
<mu1>0.2</mu1>
<mu2>0.2</mu2>
<material>Gazebo/GreenGlow</material>
</gazebo>

<gazebo reference="rwr_link">
<mu1>0.2</mu1>
<mu2>0.2</mu2>
<material>Gazebo/DarkGrey</material>
</gazebo>

<gazebo reference="rwl_link">
<mu1>0.2</mu1>
<mu2>0.2</mu2>
<material>Gazebo/DarkGrey</material>
</gazebo>

<gazebo reference="fwr_link">
<mu1>0.2</mu1>
<mu2>0.2</mu2>
<material>Gazebo/DarkGrey</material>
</gazebo>

<gazebo reference="fwl_link">
<mu1>0.2</mu1>
<mu2>0.2</mu2>
<material>Gazebo/DarkGrey</material>
</gazebo>

<!-- Controller -->
<gazebo>
<plugin name="wheel_drive_controller" filename='libgazebo_ros_diff_drive.so'>
    <ros>
        <namespace> </namespace>
    </ros>

    <!-- Wheels -->
    <num_wheel_pairs>2</num_wheel_pairs>
    <left_joint>rwl_joint</left_joint>
    <left_joint>fwl_joint</left_joint>
    <right_joint>rwr_joint</right_joint>
    <right_joint>fwr_joint</right_joint>

    <!-- Kinematics -->
    <wheel_seperation>${body_link_y_dim+wheel_link_length}</wheel_seperation>
    <wheel_diameter>${wheel_link_radius}</wheel_diameter>

    <!-- Limits -->
    <max_wheel_torque>1000</max_wheel_torque>
    <max_wheel_acceleration>5.0</max_wheel_acceleration>

    <!-- Odometry -->
    <publish_odom>true</publish_odom>
    <publish_odom_tf>true</publish_odom_tf>
    <publish_wheel_tf>true</publish_wheel_tf>
    <odometry_frame>odom</odometry_frame>
    <robot_base_frame>dummy</robot_base_frame>
</plugin>
</gazebo>

</robot>
