<?xml version="1.0"?>
<!-- ########################################### -->
<!-- Gazebo Additional Description of robot -->
<!-- Chetan VJ© -->
<!-- ########################################### -->

<robot>
<!-- Physical Properties -->
<gazebo reference="body_link">
<mu1>0.2</mu1>
<mu2>0.2</mu2>
<!-- <material>Gazebo/GreenGlow</material> -->
</gazebo>

<gazebo reference="rwr_link">
<mu1>1.5</mu1>
<mu2>1.2</mu2>
<material>Gazebo/DarkGrey</material>
</gazebo>

<gazebo reference="rwl_link">
<mu1>1.5</mu1>
<mu2>1.2</mu2>
<material>Gazebo/DarkGrey</material>
</gazebo>

<gazebo reference="fwr_link">
<mu1>1.5</mu1>
<mu2>1.2</mu2>
<material>Gazebo/DarkGrey</material>
</gazebo>

<gazebo reference="fwl_link">
<mu1>1.5</mu1>
<mu2>1.2</mu2>
<material>Gazebo/DarkGrey</material>
</gazebo>

<!-- Camera Link  -->
<gazebo reference= "camera_link">
    <material>Gazebo/Red</material>

    <sensor name="${camera_name}" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <camera>
            <horizontal_fov>1.089</horizontal_fov>
            <image>
                <format>R8G8B8</format>
                <width>640</width>
                <height>480</height>
            </image>
            <clip>
                <near>0.05</near>
                <far>800.0</far>
            </clip>
        </camera>

        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <frame_name>camera_link_optical</frame_name>
        </plugin>
    </sensor>

</gazebo>

<!-- Lidar Link  -->
<gazebo reference="lidar_link">
    <material>Gazebo/Red</material>

    <sensor name="lidar" type="ray">
        <pose> 0 0 0 0 0 0 </pose>
        <visualize>true</visualize>
        <update_rate>1</update_rate>
        <ray>
            <scan>
                <horizontal>
                    <samples>360</samples>
                    <min_angle>-3.14</min_angle>
                    <max_angle>3.14</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.3</min>
                <max>12</max>
            </range>
        </ray>
        <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
            <ros>
                <remapping>~/out:=scan</remapping>
            </ros>
            <output_type>sensor_msgs/LaserScan</output_type>
            <frame_name>laser_frame</frame_name>
        </plugin>
    </sensor>
</gazebo>


<!-- Differential Drive Controller -->
<gazebo>
<plugin name="wheel_drive_controller" filename='libgazebo_ros_diff_drive.so'>
    <ros>
        <namespace> </namespace>
    </ros>

    <!-- Wheels -->
    <num_wheel_pairs>2</num_wheel_pairs>
    <left_joint>rwl_joint</left_joint>
    <left_joint>fwl_joint</left_joint>
    <right_joint>rwr_joint</right_joint>
    <right_joint>fwr_joint</right_joint>

    <!-- Kinematics -->
    <wheel_seperation>${body_link_y_dim+wheel_link_length}</wheel_seperation>
    <wheel_diameter>${wheel_link_radius}</wheel_diameter>

    <!-- Limits -->
    <max_wheel_torque>1000</max_wheel_torque>
    <max_wheel_acceleration>5.0</max_wheel_acceleration>

    <!-- Odometry -->
    <publish_odom>true</publish_odom>
    <publish_odom_tf>true</publish_odom_tf>
    <publish_wheel_tf>true</publish_wheel_tf>
    <odometry_frame>odom</odometry_frame>
    <robot_base_frame>dummy</robot_base_frame>
</plugin>

</gazebo>

</robot>
